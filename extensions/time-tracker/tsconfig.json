{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./out",
		"rootDir": "./src",
		"types": ["node", "better-sqlite3"],
		"typeRoots": ["../../node_modules/@types"],
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"moduleResolution": "node"
	},
	"include": ["src/**/*", "../../src/vscode-dts/vscode.d.ts"],
	"exclude": ["node_modules"]
}
