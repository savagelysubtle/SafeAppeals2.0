{
  "name": "time-tracker",
  "displayName": "Legal Time Tracker",
  "description": "Professional time tracking with UTBMS codes, 6-minute billing increments, and LEDES export",
  "version": "1.0.0",
  "publisher": "safeappeals",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "timeTracker.start",
        "title": "Start Timer",
        "category": "Time Tracker",
        "icon": "$(play)"
      },
      {
        "command": "timeTracker.stop",
        "title": "Stop Timer",
        "category": "Time Tracker",
        "icon": "$(debug-stop)"
      },
      {
        "command": "timeTracker.toggle",
        "title": "Toggle Timer",
        "category": "Time Tracker",
        "icon": "$(clock)"
      },
      {
        "command": "timeTracker.addEntry",
        "title": "Add Manual Entry",
        "category": "Time Tracker",
        "icon": "$(add)"
      },
      {
        "command": "timeTracker.manageMatter",
        "title": "Manage Matters",
        "category": "Time Tracker"
      },
      {
        "command": "timeTracker.manageRates",
        "title": "Manage Billing Rates",
        "category": "Time Tracker"
      },
      {
        "command": "timeTracker.exportCSV",
        "title": "Export to CSV",
        "category": "Time Tracker"
      },
      {
        "command": "timeTracker.exportJSON",
        "title": "Export to JSON",
        "category": "Time Tracker"
      },
      {
        "command": "timeTracker.exportLEDES",
        "title": "Export to LEDES 1998B",
        "category": "Time Tracker"
      },
      {
        "command": "timeTracker.clearLocalDatabase",
        "title": "Delete Local Time Tracking Database",
        "category": "Time Tracker"
      }
    ],
    "keybindings": [
      {
        "command": "timeTracker.toggle",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      },
      {
        "command": "timeTracker.addEntry",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "timeTracker",
          "title": "Time Tracker",
          "icon": "$(clock)"
        }
      ]
    },
    "views": {
      "timeTracker": [
        {
          "type": "webview",
          "id": "timeTracker.sidebar",
          "name": "Time Tracker"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "safeappeals_timer_getState",
        "toolReferenceName": "timerGetState",
        "displayName": "Timer Get State",
        "modelDescription": "Return the current legal time-tracker state: whether a timer is running, elapsed time, matter/rate ids, description, and billable flag. Use before start/stop.",
        "userDescription": "Get the current timer state",
        "canBeReferencedInPrompt": true,
        "icon": "$(clock)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "safeappeals_timer_start",
        "toolReferenceName": "timerStart",
        "displayName": "Timer Start",
        "modelDescription": "Start the legal time tracker non-interactively. Optional description, matterId, rateId, and isBillable. Stops any currently running timer first.",
        "userDescription": "Start the time tracker",
        "canBeReferencedInPrompt": true,
        "icon": "$(play)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "description": "What you are working on."
            },
            "matterId": {
              "type": [
                "number",
                "null"
              ],
              "description": "Optional matter id from the time tracker."
            },
            "rateId": {
              "type": [
                "number",
                "null"
              ],
              "description": "Optional billing rate id."
            },
            "isBillable": {
              "type": "boolean",
              "description": "Defaults to true."
            }
          }
        }
      },
      {
        "name": "safeappeals_timer_stop",
        "toolReferenceName": "timerStop",
        "displayName": "Timer Stop",
        "modelDescription": "Stop the running timer and save a time entry. Uses the current description (or 'No description' if empty). Does not send email or export.",
        "userDescription": "Stop the time tracker and save an entry",
        "canBeReferencedInPrompt": true,
        "icon": "$(debug-stop)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "configuration": {
      "title": "Time Tracker",
      "properties": {
        "timeTracker.defaultRoundingMode": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "nearest"
          ],
          "default": "up",
          "description": "How to round time to 0.1 hour increments"
        },
        "timeTracker.minimumIncrement": {
          "type": "number",
          "default": 0.1,
          "description": "Minimum billable time in hours (0.1 = 6 minutes)"
        },
        "timeTracker.descriptionMaxLength": {
          "type": "number",
          "default": 500,
          "description": "Maximum description length (many clients cap at 500)"
        },
        "timeTracker.autoStopOnClose": {
          "type": "boolean",
          "default": true,
          "description": "Automatically stop and save running timer when VSCode closes"
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:time-tracker",
    "watch": "gulp watch-extension:time-tracker",
    "lint": "eslint src --ext ts",
    "rebuild-prebuilds": "node ./scripts/rebuild-prebuilds.js"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "24.x"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@12.11.1": true
  }
}
