# Windows-specific module ignores
# Exclude non-Windows native binaries when building for Windows

# Whisper node addon - exclude macOS and Linux binaries
@kutalia/whisper-node-addon/dist/mac-x64/**
@kutalia/whisper-node-addon/dist/mac-arm64/**
@kutalia/whisper-node-addon/dist/linux-x64/**

# node-pty prebuilds - exclude non-Windows
node-pty/prebuilds/darwin-x64/**
node-pty/prebuilds/darwin-arm64/**
node-pty/prebuilds/linux-x64/**

# bare-fs prebuilds - exclude non-Windows
bare-fs/prebuilds/darwin-*/**
bare-fs/prebuilds/linux-*/**
bare-fs/prebuilds/android-*/**
bare-fs/prebuilds/ios-*/**

# bare-os prebuilds - exclude non-Windows
bare-os/prebuilds/darwin-*/**
bare-os/prebuilds/linux-*/**
bare-os/prebuilds/android-*/**
bare-os/prebuilds/ios-*/**

# bare-url prebuilds - exclude non-Windows
bare-url/prebuilds/darwin-*/**
bare-url/prebuilds/linux-*/**
bare-url/prebuilds/android-*/**
bare-url/prebuilds/ios-*/**
