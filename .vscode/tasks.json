{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install & Watch (Client)",
			"detail": "Install dependencies, compile and watch VS Code core for fixing a bug or implementing a feature.",
			"dependsOn": [
				"Install Dependencies",
				"Compile",
				"Watch Client Transpile"
			],
			"dependsOrder": "sequence",
			"inAgents": true,
			"problemMatcher": []
		},
		{
			"label": "Run VS Code",
			"detail": "DESKTOP: launch the Electron app with an isolated profile (.profile-oss inside the worktree). Same as Run Dev but keeps settings/extensions separate from your normal profile - good for clean-slate testing.",
			"type": "shell",
			"command": "./scripts/code.sh",
			"windows": {
				"command": ".\\scripts\\code.bat"
			},
			"args": [
				"--user-data-dir=${workspaceFolder}/.profile-oss",
				"--extensions-dir=${workspaceFolder}/.profile-oss/extensions"
			],
			"inAgents": true,
			"problemMatcher": []
		},
		{
			"label": "Watch & Run Electron App",
			"detail": "DESKTOP: run the watchers (npm run watch), then launch the native Electron app. Use this for performance testing - real desktop runtime, native modules, GPU rendering. See https://github.com/microsoft/vscode/wiki/How-to-Contribute#desktop",
			"dependsOn": [
				"Watch",
				"Run VS Code"
			],
			"dependsOrder": "sequence",
			"inAgents": true,
			"problemMatcher": []
		},
		{
			"label": "Run VS Code CLI",
			"detail": "Run CLI commands against the dev build (eg. --version). Pass extra args via the terminal after the task starts.",
			"type": "shell",
			"command": "./scripts/code-cli.sh",
			"windows": {
				"command": ".\\scripts\\code-cli.bat"
			},
			"args": [
				"--version"
			],
			"problemMatcher": []
		},
		{
			"label": "Install & Watch (All)",
			"detail": "Install dependencies and watch all of VS Code (core, extensions and copilot).",
			"dependsOn": [
				"Install Dependencies",
				"Watch"
			],
			"dependsOrder": "sequence",
			"inAgents": true,
			"problemMatcher": []
		},
		{
			"label": "Install Dependencies",
			"detail": "Uses npm (not bun) - Bun sandboxes postinstall/node-gyp lifecycle scripts by default, which would break native module builds against the Electron ABI (see .npmrc).",
			"type": "shell",
			"command": "npm install",
			"windows": {
				"command": "cmd /c \"npm install\""
			},
			"presentation": {
				"reveal": "always",
				"group": "session",
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Compile",
			"type": "npm",
			"script": "compile",
			"presentation": {
				"reveal": "always",
				"group": "session",
				"close": false
			},
			"problemMatcher": "$tsc"
		},
		{
			"label": "Watch",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"group": "session",
				"close": false
			},
			"problemMatcher": {
				"owner": "watch-all",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting all watchers\\.\\.\\.",
					"endsPattern": "Watchers done and ready for changes"
				}
			}
		},
		{
			"label": "Watch Client Transpile",
			"type": "npm",
			"script": "watch-client-transpile",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"group": "session",
				"close": false
			},
			"problemMatcher": {
				"owner": "esbuild",
				"applyTo": "closedDocuments",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/src"
				],
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+): ERROR: (.+)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				},
				"background": {
					"beginsPattern": "Starting transpilation\\.\\.\\.",
					"endsPattern": "Finished transpilation with"
				}
			},
			"inAgents": true,
		},
		{
			"type": "npm",
			"script": "watch-client-transpiled",
			"label": "Core - Transpile",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "buildWatchers",
				"close": false
			},
			"problemMatcher": {
				"owner": "esbuild",
				"applyTo": "closedDocuments",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/src"
				],
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+): ERROR: (.+)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				},
				"background": {
					"beginsPattern": "Starting transpilation\\.\\.\\.",
					"endsPattern": "Finished transpilation with"
				}
			}
		},
		{
			"type": "npm",
			"script": "watch-clientd",
			"label": "Core - Typecheck",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "buildWatchers",
				"close": false
			},
			"problemMatcher": {
				"owner": "typescript",
				"applyTo": "closedDocuments",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"source": "ts",
				"pattern": {
					"regexp": "\\] (.+)\\(([\\d,]+)\\): error TS(\\d+): (.*)$",
					"file": 1,
					"location": 2,
					"code": 3,
					"message": 4
				},
				"background": {
					"beginsPattern": "Starting compilation\\.\\.\\.",
					"endsPattern": "Finished compilation with"
				}
			}
		},
		{
			"type": "npm",
			"script": "watch-extensionsd",
			"label": "Ext - Build",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "buildWatchers",
				"close": false
			},
			"problemMatcher": {
				"owner": "typescript",
				"applyTo": "closedDocuments",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "\\] ([^(]+)\\((\\d+,\\d+)\\): (.*)$",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"beginsPattern": "Starting compilation",
					"endsPattern": "Finished compilation"
				}
			}
		},
		{
			"type": "npm",
			"script": "watch-copilotd",
			"label": "Copilot - Build",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "buildWatchers",
				"close": false
			},
			"problemMatcher": [
				"$esbuild-watch",
				{
					"owner": "typescript",
					"applyTo": "closedDocuments",
					"fileLocation": [
						"relative",
						"${workspaceFolder}/extensions/copilot"
					],
					"pattern": {
						"regexp": "\\] ([^(]+)\\((\\d+,\\d+)\\): (.*)$",
						"file": 1,
						"location": 2,
						"message": 3
					},
					"background": {
						"beginsPattern": "File change detected\\. Starting incremental compilation",
						"endsPattern": "Found \\d+ errors?\\. Watching for file changes"
					}
				}
			]
		},
		{
			"label": "VS Code - Build",
			"dependsOn": [
				"Core - Transpile",
				"Core - Typecheck",
				"Ext - Build",
				"Copilot - Build"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "kill-watch-client-transpiled",
			"label": "Kill Core - Transpile",
			"group": "build",
			"presentation": {
				"reveal": "never",
				"group": "buildKillers",
				"close": true
			},
			"problemMatcher": "$tsc"
		},
		{
			"type": "npm",
			"script": "kill-watch-clientd",
			"label": "Kill Core - Typecheck",
			"group": "build",
			"presentation": {
				"reveal": "never",
				"group": "buildKillers",
				"close": true
			},
			"problemMatcher": "$tsc"
		},
		{
			"type": "npm",
			"script": "kill-watch-extensionsd",
			"label": "Kill Ext - Build",
			"group": "build",
			"presentation": {
				"reveal": "never",
				"group": "buildKillers",
				"close": true
			},
			"problemMatcher": "$tsc"
		},
		{
			"type": "npm",
			"script": "kill-watch-copilotd",
			"label": "Kill Copilot - Build",
			"group": "build",
			"presentation": {
				"reveal": "never",
				"group": "buildKillers",
				"close": true
			},
			"problemMatcher": "$esbuild"
		},
		{
			"label": "Kill VS Code - Build",
			"dependsOn": [
				"Kill Core - Transpile",
				"Kill Core - Typecheck",
				"Kill Ext - Build",
				"Kill Copilot - Build"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Restart VS Code - Build",
			"dependsOn": [
				"Kill VS Code - Build",
				"VS Code - Build"
			],
			"group": "build",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Kill VS Code - Build, Npm, VS Code - Build",
			"dependsOn": [
				"Kill VS Code - Build",
				"Install Dependencies",
				"VS Code - Build"
			],
			"group": "build",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "watch-webd",
			"label": "Web Ext - Build",
			"group": "build",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"problemMatcher": {
				"owner": "typescript",
				"applyTo": "closedDocuments",
				"fileLocation": [
					"absolute"
				],
				"pattern": {
					"regexp": "Error: ([^(]+)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\): (.*)$",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"beginsPattern": "Starting compilation",
					"endsPattern": "Finished compilation"
				}
			}
		},
		{
			"type": "npm",
			"script": "kill-watch-webd",
			"label": "Kill Web Ext - Build",
			"group": "build",
			"presentation": {
				"reveal": "never"
			},
			"problemMatcher": "$tsc"
		},
		{
			"label": "Run tests",
			"type": "shell",
			"command": "./scripts/test.sh",
			"windows": {
				"command": ".\\scripts\\test.bat"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always"
			}
		},
		{
			"label": "Run Dev Agents",
			"type": "shell",
			"command": "./scripts/code.sh",
			"windows": {
				"command": ".\\scripts\\code.bat"
			},
			"args": [
				"--agents",
				"--user-data-dir=${userHome}/.safe-appeals-dev",
				"--extensions-dir=${userHome}/.safe-appeals-dev/extensions"
			],
			"problemMatcher": []
		},
		{
			"label": "Transpile Client",
			"type": "npm",
			"script": "transpile-client",
			"problemMatcher": []
		},
		{
			"label": "Run and Compile Agents - OSS",
			"dependsOn": [
				"Transpile Client",
				"Run Dev Agents"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Run and Compile Code - OSS",
			"dependsOn": [
				"Transpile Client",
				"Run Dev"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "electron",
			"label": "Download electron"
		},
		{
			"type": "gulp",
			"task": "hygiene",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"command": "./scripts/code-web.sh",
			"windows": {
				"command": ".\\scripts\\code-web.bat"
			},
			"args": [
				"--port",
				"8080",
				"--browser",
				"none"
			],
			"label": "Run code web",
			"detail": "BROWSER (serverless): serve the pure web build at http://localhost:8080 - no NodeJS backend, web extensions only. For everyday SafeAppeals UI/E2E work prefer Run Dev (CDP) (desktop Electron on port 9222), not this web build.",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": ""
				},
				"background": {
					"beginsPattern": ".*node .*",
					"endsPattern": "Listening on .*"
				}
			},
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "Run Dev (WEB)",
			"detail": "BROWSER: serve the app at http://localhost:8080/?tkn=dev-token (open manually). Use only when testing the browser/code-server build. For everyday SafeAppeals UI/E2E work prefer Run Dev (CDP) (desktop Electron on port 9222).",
			"type": "shell",
			"command": "./scripts/code-server.sh",
			"windows": {
				"command": ".\\scripts\\code-server.bat"
			},
			"args": [
				"--connection-token",
				"dev-token",
				"--port",
				"8080"
			],
			"inAgents": true,
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": ""
				},
				"background": {
					"beginsPattern": ".*node .*",
					"endsPattern": "Web UI available at .*"
				}
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Run Code Server (Launch Browser)",
			"detail": "BROWSER: same as Run Dev (WEB) but opens your browser automatically. Prefer Run Dev (CDP) for everyday SafeAppeals UI/E2E; use this only when testing the browser/code-server build.",
			"type": "shell",
			"command": "./scripts/code-server.sh",
			"windows": {
				"command": ".\\scripts\\code-server.bat"
			},
			"args": [
				"--launch",
				"--connection-token",
				"dev-token",
				"--port",
				"8080"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": ""
				},
				"background": {
					"beginsPattern": ".*node .*",
					"endsPattern": "Web UI available at .*"
				}
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Watch & Run Code Server (Web UI, Desktop Extensions)",
			"detail": "BROWSER: run the watchers (npm run watch), then serve the UI in the browser (auto-opens). One-shot task for a UI-upgrade session: edit code, wait for recompile, reload the tab. See https://github.com/microsoft/vscode/wiki/How-to-Contribute#code-server-web",
			"dependsOn": [
				"Watch",
				"Run Code Server (Launch Browser)"
			],
			"dependsOrder": "sequence",
			"inAgents": true,
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "eslint",
			"problemMatcher": {
				"source": "eslint",
				"base": "$eslint-stylish"
			}
		},
		{
			"type": "shell",
			"command": "node build/lib/preLaunch.ts",
			"label": "Ensure Prelaunch Dependencies",
			"presentation": {
				"reveal": "silent",
				"close": true
			}
		},
		{
			"type": "npm",
			"script": "tsec-compile-check",
			"problemMatcher": [
				{
					"base": "$tsc",
					"applyTo": "allDocuments",
					"owner": "tsec"
				}
			],
			"group": "build",
			"label": "npm: tsec-compile-check",
			"detail": "node_modules/tsec/bin/tsec -p src/tsconfig.json --noEmit"
		},
		{
			"label": "Launch Monaco Editor Vite",
			"type": "shell",
			"command": "bun run dev",
			"options": {
				"cwd": "./build/vite/"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": "(Local|Network):.*"
				}
			}
		},
		{
			"label": "Launch MCP Server",
			"type": "shell",
			"command": "cd test/mcp && bun run compile && bun run start-http",
			"isBackground": true,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run Dev",
			"detail": "DESKTOP: launch the full app in Electron with your normal profile. Use this to test real app performance (native modules, GPU rendering, startup time). Requires a Watch task already running.",
			"type": "shell",
			"command": "./scripts/code.sh",
			"windows": {
				"command": ".\\scripts\\code.bat"
			},
			"problemMatcher": []
		},
		{
			"label": "Run Dev (CDP)",
			"detail": "PREFERRED for agent UI/E2E: same as Run Dev, plus --remote-debugging-port=9222. Agents should attach Playwright/CDP to this window (http://127.0.0.1:9222) instead of Run Dev (WEB) or a throwaway launch.sh instance.",
			"type": "shell",
			"command": "./scripts/code.sh",
			"windows": {
				"command": ".\\scripts\\code.bat"
			},
			"args": [
				"--remote-debugging-port=9222"
			],
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "watch-client",
			"label": "Watch Client",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "buildWatchers",
				"close": false
			},
			"problemMatcher": {
				"owner": "typescript",
				"applyTo": "closedDocuments",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"source": "ts",
				"pattern": {
					"regexp": "\\] (.+)\\(([\\d,]+)\\): error TS(\\d+): (.*)$",
					"file": 1,
					"location": 2,
					"code": 3,
					"message": 4
				},
				"background": {
					"beginsPattern": "Starting compilation\\.\\.\\.",
					"endsPattern": "Finished compilation with"
				}
			}
		},
		{
			"label": "Component Explorer Server",
			"type": "shell",
			"command": "bunx component-explorer serve -p ./test/componentFixtures/component-explorer.json -vv --kill-if-running",
			"isBackground": true,
			"inAgents": true,
			"problemMatcher": {
				"owner": "component-explorer",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^\\s*at\\s+(.+?):(\\d+):(\\d+)\\s*$",
					"file": 1,
					"line": 2,
					"column": 3
				},
				"background": {
					"activeOnStart": false,
					"beginsPattern": ".*Setting up sessions.*",
					"endsPattern": "  current: (?<componentExplorerUrl>.*) \\(current\\)"
				}
			}
		},
		{
			"label": "Install & Watch",
			"detail": "npm install is kept for native module builds against the Electron ABI (see .npmrc); the watch script runs via bun.",
			"type": "shell",
			"command": "npm install && bun run watch-transpile",
			"windows": {
				"command": "cmd /c \"npm install && bun run watch-transpile\""
			},
			"presentation": {
				"focus": false,
				"reveal": "never"
			}
		},
		{
			"label": "Serve Out (rspack)",
			"type": "npm",
			"script": "serve-out-rspack",
			"isBackground": true,
			"problemMatcher": {
				"owner": "rspack",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*compiling.*",
					"endsPattern": ".*compiled.*successfully.*"
				}
			}
		},
	]
}
